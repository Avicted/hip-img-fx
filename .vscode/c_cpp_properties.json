{
    "configurations": [
        {
            "name": "Linux-HIP",
            "compilerPath": "/opt/rocm/bin/hipcc",
            "cStandard": "c17",
            "cppStandard": "c++20",
            // "intelliSenseMode": "linux-clang-x64",
            "includePath": [
                "${workspaceFolder}/src/core",
                "${workspaceFolder}/src/core/filters",
                "/opt/rocm/include",
                "/usr/include",
                "/usr/local/include"
            ],
            "browse": {
                "path": [
                    "${workspaceFolder}/src/core",
                    "${workspaceFolder}/src/core/filters",
                    "/opt/rocm/include",
                    "/usr/include",
                    "/usr/local/include"
                ],
                "limitSymbolsToIncludedHeaders": true
            }
        }
    ],
    "version": 4
}