{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug hip-img-fx",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/src/app/hip-img-fx",
            "args": [
                "--input",
                "examples",
                "--filter",
                "grayscale",
                "--output",
                "examples/output",
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Meson: Build"
        },
        {
            "name": "Run hip-img-fx (no debug)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/src/app/hip-img-fx",
            "args": [],
            "cwd": "${workspaceFolder}",
            "externalConsole": true,
            "MIMode": "gdb",
            "preLaunchTask": "Meson: Build"
        }
    ]
}