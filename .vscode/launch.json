{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug hip-img-fx",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/hip-img-fx",
            "args": [
                "--input",
                // "examples",
                "/home/avic/Pictures/train/",
                "--filter",
                "grayscale",
                "--output",
                "/home/avic/Pictures/train_output/",
                //"examples/output_filter_negative",
                // "--use-cpu",
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Meson: Build"
        },
    ]
}