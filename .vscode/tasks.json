{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Meson: Configure",
            "type": "shell",
            "command": "meson setup build --native-file native/hip.ini --reconfigure",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Meson: Build",
            "type": "shell",
            "command": "ninja -C build",
            "problemMatcher": [
                "$gcc"
            ],
            "dependsOn": [
                "Meson: Configure"
            ]
        },
        {
            "label": "Meson: Clean",
            "type": "shell",
            "command": "ninja -C build clean",
            "problemMatcher": []
        },
        {
            "label": "Run hip-img-fx",
            "type": "shell",
            "command": "./build/src/app/hip-img-fx",
            "dependsOn": [
                "Meson: Build"
            ],
            "group": "none",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}